# ── Merit Store Supabase project (create a NEW project) ─────────────────────
# Dashboard → Project Settings → API

# Browser (safe to expose): used ONLY for email sign-in links.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Server only — NEVER prefix with VITE_ and never commit. Set these in
# Netlify → Site configuration → Environment variables (scope: Functions/Runtime).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Password an admin must re-enter to remove a record (replaces the old hardcoded one).
ADMIN_ACTION_PASSWORD=choose-a-long-passphrase

# Fleet Merits LIVE — defaults in fleetClient.ts (optional override)
# VITE_FLEET_SUPABASE_URL=https://bgxgdgoegnjxuzatiqed.supabase.co
# VITE_FLEET_SUPABASE_ANON_KEY=...
